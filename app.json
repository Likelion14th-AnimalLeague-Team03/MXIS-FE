{
  "expo": {
    "name": "MXIS",
    "slug": "mxisbasic",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mxis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.mxis.app",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mxis.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Smart Charm connection uses Bluetooth."
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Smart Charm connection uses Bluetooth."
        }
      ]
    ]
  }
}
